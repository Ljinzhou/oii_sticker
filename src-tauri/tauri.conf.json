{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oii_sticker",
  "version": "../package.json",
  "identifier": "com.ljz.oiisticker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "oii_sticker 主控台",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEQUExRkYyNzA3QjYzMEQKUldRTlkzdHc4aCtxL2JVQ1hRNHlDSzlLWnlTMFRmZEpUWXh3UE5xQWUyTE1CVFd2c2RmYVlqU0wK",
      "endpoints": [
        "https://github.com/Ljinzhou/oii_sticker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
